datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// --- Taxonomy: Genre ---
// We use explicit join tables to model M:N with Artist and Album.
// This allows targeted indexing and future per-relationship attributes.
model Genre {
  id    String  @id @default(uuid())          // UUID PK
  name  String  @unique                       // Human readable (unique)
  slug  String  @unique                       // URL-friendly (unique)

  // Relations via join tables
  artistGenres ArtistGenre[]
  albumGenres  AlbumGenre[]

  @@index([slug])
}

// --- Join table: Artist <-> Genre ---
model ArtistGenre {
  // Composite PK ensures uniqueness of the (artistId, genreId) pair.
  artistId String
  genreId  String

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  genre  Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([artistId, genreId])
  @@index([genreId])
}

// --- Join table: Album <-> Genre ---
model AlbumGenre {
  albumId String
  genreId String

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([albumId, genreId])
  @@index([genreId])
}

// --- Playback History ---
// Logs significant plays (>30s). Optimized for "last 30 days" queries.
model PlaybackHistory {
  id       String   @id @default(uuid())        // UUID PK
  userId   String                                // FK to User (string PK)
  trackId  String                                // FK to Track (string PK)
  playedAt DateTime @default(now())              // When the play occurred
  context  String?                               // Optional source: "album_page", "discovery_feed", etc.

  // Relations (assuming existing User and Track models use String PKs `id`)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  // Compound index accelerates range scans by user and time (e.g., last 30 days).
  @@index([userId, playedAt])
}

// --- Join table: User <-> Artist (Likes) ---
model UserLikedArtist {
  userId   String
  artistId String
  likedAt  DateTime @default(now()) // Optional: track when the like occurred

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([userId, artistId])
  @@index([userId])
  @@index([artistId])
}

// --- Join table: User <-> Album (Likes) ---
model UserLikedAlbum {
  userId  String
  albumId String
  likedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@id([userId, albumId])
  @@index([userId])
  @@index([albumId])
}

// --- Join table: User <-> Track (Likes) ---
model UserLikedTrack {
  userId  String
  trackId String
  likedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([userId, trackId])
  @@index([userId])
  @@index([trackId])
}

// --- Core Content Models ---
model Artist {
  id        String   @id @default(uuid())
  mbId      String   @unique // MusicBrainz ID
  name      String
  tags      String[] // Array of genre/style tags
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  albums  Album[]
  genres  ArtistGenre[]
  likedBy UserLikedArtist[]

  @@index([mbId])
  @@index([name])
}

model Album {
  id          String    @id @default(uuid())
  mbId        String    @unique // MusicBrainz ID
  title       String
  releaseDate DateTime?
  coverUrl    String?
  artistId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  artist  Artist         @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tracks  Track[]
  genres  AlbumGenre[]
  likedBy UserLikedAlbum[]

  @@index([mbId])
  @@index([artistId])
}

model Track {
  id        String   @id @default(uuid())
  mbId      String   @unique // MusicBrainz ID
  title     String
  duration  Int      // Duration in seconds
  albumId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  album        Album              @relation(fields: [albumId], references: [id], onDelete: Cascade)
  fingerprints AudioFingerprint[]
  playbacks    PlaybackHistory[]
  likedBy      UserLikedTrack[]

  @@index([mbId])
  @@index([albumId])
}

// --- Audio Fingerprinting ---
model AudioFingerprint {
  id        String   @id @default(uuid())
  hash      String   @unique // AcoustID fingerprint hash
  duration  Int      // Duration in seconds
  trackId   String
  createdAt DateTime @default(now())

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([hash])
  @@index([trackId])
}

// --- User Model ---
model User {
  id String @id

  // Optional reverse relation to playback logs
  playbacks    PlaybackHistory[]

  // New: User's liked content
  likedArtists UserLikedArtist[]
  likedAlbums  UserLikedAlbum[]
  likedTracks  UserLikedTrack[]
}