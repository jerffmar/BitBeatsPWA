// --- Taxonomy: Genre ---
// We use explicit join tables to model M:N with Artist and Album.
// This allows targeted indexing and future per-relationship attributes.
model Genre {
  id    String  @id @default(uuid())          // UUID PK
  name  String  @unique                       // Human readable (unique)
  slug  String  @unique                       // URL-friendly (unique)

  // Relations via join tables
  artistGenres ArtistGenre[]
  albumGenres  AlbumGenre[]

  @@index([slug])
}

// --- Join table: Artist <-> Genre ---
model ArtistGenre {
  // Composite PK ensures uniqueness of the (artistId, genreId) pair.
  artistId String
  genreId  String

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  genre  Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([artistId, genreId])
  @@index([genreId])
}

// --- Join table: Album <-> Genre ---
model AlbumGenre {
  albumId String
  genreId String

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([albumId, genreId])
  @@index([genreId])
}

// --- Playback History ---
// Logs significant plays (>30s). Optimized for "last 30 days" queries.
model PlaybackHistory {
  id       String   @id @default(uuid())        // UUID PK
  userId   String                                // FK to User (string PK)
  trackId  String                                // FK to Track (string PK)
  playedAt DateTime @default(now())              // When the play occurred
  context  String?                               // Optional source: "album_page", "discovery_feed", etc.

  // Relations (assuming existing User and Track models use String PKs `id`)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  // Compound index accelerates range scans by user and time (e.g., last 30 days).
  @@index([userId, playedAt])
}

