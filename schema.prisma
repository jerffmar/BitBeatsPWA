// ------------------------------------------------------------
// Genre taxonomy used for discovery and recommendation.
// Implicit many-to-many relations are used: Prisma will create
// join tables automatically (e.g., _ArtistToGenre, _AlbumToGenre).
// ------------------------------------------------------------
model Genre {
  id    String  @id @default(uuid())   // UUID PK
  name  String  @unique                // Unique genre name
  slug  String  @unique                // URL-friendly unique slug

  // Back-relations generated by implicit M:N from Artist/Album
  artists Artist[]                     // Genres applied to artists
  albums  Album[]                      // Genres applied to albums

  @@index([slug])
}

// ------------------------------------------------------------
// Playback history logs for recommendation queries.
// Indexed by (userId, playedAt) for efficient "last N days" scans.
// ------------------------------------------------------------
model PlaybackHistory {
  id       String   @id @default(uuid()) // UUID PK
  userId   String                         // FK to User.id (String)
  trackId  String                         // FK to Track.id (String)
  playedAt DateTime @default(now())       // Timestamp of play
  context  String?                        // Optional source context (e.g., "album_page")

  // Relations (assumes existing User and Track models with String ids)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([userId, playedAt])             // Optimizes recent history queries
}

// ------------------------------------------------------------
// Existing models extended with implicit M:N to Genre.
// The rest of their fields remain unchanged.
// ------------------------------------------------------------
model Artist {
  // ...existing code...
  genres Genre[] // Implicit M:N: Artist <-> Genre
  // ...existing code...
}

model Album {
  // ...existing code...
  genres Genre[] // Implicit M:N: Album <-> Genre
  // ...existing code...
}

// ------------------------------------------------------------
// Assumed existing models (User, Track) with String id PKs.
// No changes required here unless they differ; shown for clarity.
// ------------------------------------------------------------
model User {
  // ...existing code...
  id String @id
  // ...existing code...
  // Optional: back-relation for history
  playback PlaybackHistory[]
}

model Track {
  // ...existing code...
  id String @id
  // ...existing code...
  // Optional: back-relation for history
  plays PlaybackHistory[]
}
